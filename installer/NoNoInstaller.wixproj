<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <OutputName>NoNo-Desktop-Pet-$(ProductVersion)-x64</OutputName>
    <OutputPath>..\release\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>ProductVersion=$(ProductVersion);AppDir=$(MSBuildProjectDirectory)\..\standalone\bin\Release\net48;DistDir=$(MSBuildProjectDirectory)\..\dist;VoiceDir=$(MSBuildProjectDirectory)\..\voice;SourceDir=$(MSBuildProjectDirectory)\..</DefineConstants>
    <Cultures>zh-CN</Cultures>
    <!-- ICE91 is expected: this package is intentionally per-user only. -->
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
  </ItemGroup>
</Project>
