<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>NoNo-Desktop-Pet-Setup-$(ProductVersion)-x64</AssemblyName>
    <RootNamespace>NoNoSetup</RootNamespace>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildProjectDirectory)\..\release\NoNo-Desktop-Pet-$(ProductVersion)-x64.msi</MsiPath>
    <Version>$(ProductVersion)</Version>
    <FileVersion>$(ProductVersion).0</FileVersion>
    <AssemblyVersion>$(ProductVersion).0</AssemblyVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\standalone\nono.ico</ApplicationIcon>
    <OutputPath>..\release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NoNoSetup.cs" />
    <EmbeddedResource Include="$(MsiPath)" LogicalName="NoNo.Setup.Payload.msi" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
