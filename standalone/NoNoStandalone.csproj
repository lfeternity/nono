<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NoNo-Standalone</AssemblyName>
    <RootNamespace>NoNoStandalone</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>nono.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="NoNoStandalone.cs" />
    <Compile Include="VoiceAssistant.cs" Condition="Exists('VoiceAssistant.cs')" />
    <Compile Include="VoiceCommandRouter.cs" Condition="Exists('VoiceCommandRouter.cs')" />
    <Compile Include="DesktopAgent.cs" Condition="Exists('DesktopAgent.cs')" />
    <Compile Include="ComputerControl.cs" Condition="Exists('ComputerControl.cs')" />
    <Compile Include="CodexComputerModels.cs" Condition="Exists('CodexComputerModels.cs')" />
    <Compile Include="CodexComputerSafety.cs" Condition="Exists('CodexComputerSafety.cs')" />
    <Compile Include="CodexComputerPolicy.cs" Condition="Exists('CodexComputerPolicy.cs')" />
    <Compile Include="CodexComputerTools.cs" Condition="Exists('CodexComputerTools.cs')" />
    <Compile Include="ExtendedComputerControl.cs" Condition="Exists('ExtendedComputerControl.cs')" />
    <Compile Include="CodexComputerBridge.cs" Condition="Exists('CodexComputerBridge.cs')" />
    <Content Include="app.manifest" />
    <Content Include="nono.ico" />
    <EmbeddedResource Include="..\run-nono\final\spritesheet.png" LogicalName="spritesheet.png" />
    <Content Include="..\voice\voice_service.py" Link="voice\voice_service.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\voice\requirements.txt" Link="voice\requirements.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\voice\setup.ps1" Link="voice\setup.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\voice\download_ollama.ps1" Link="voice\download_ollama.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\voice\download_sherpa.ps1" Link="voice\download_sherpa.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\voice\download_tts.ps1" Link="voice\download_tts.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\voice\README.md" Link="voice\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Speech" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
